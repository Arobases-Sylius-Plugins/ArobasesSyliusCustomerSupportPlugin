{% extends '@SyliusShop/Account/layout.html.twig' %}
{% import '@SyliusShop/Macro/messages.html.twig' as messages %}

{% form_theme form '@SyliusShop/Form/theme.html.twig' %}
{% block title %}{{ 'arobases_sylius_customer_support_plugin.ui.new_ticket'|trans }}  | {{ parent() }}{% endblock %}

{% block subcontent %}
    {% dump(sylius.customer.orders|length ) %}
    {% if sylius.customer.orders|length > 0 %}
    {{ form_start(form, {'action': path('arobases_sylius_customer_support_plugin_shop_customer_support_create'),'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate'}}) }}

    {{ form_errors(form) }}
    {{ form_row(form.order) }}
    {{ form_row(form.customerSupportAnswers.file) }}
    {{ form_row(form.customerSupportAnswers.message) }}

    <div class="ui hidden divider"></div>
    <div class="ui buttons">
        <button class="ui labeled icon primary button" type="submit" id="sylius_save_changes_button"><i class="save icon"></i> {{ 'arobases_sylius_customer_support_plugin.form.to_create'|trans }}</button>
    </div>

    {{ form_row(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
    {% else %}
        {{ messages.info('arobases_sylius_customer_support_plugin.ui.no_orders') }}

    {% endif %}

{% endblock %}



